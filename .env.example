# ── Alpaca ────────────────────────────────────────────────────────────────────
# Paper trading (default). Change to live URL only after reading the live-trading
# safety section in the README.
ALPACA_API_KEY=your_alpaca_paper_api_key
ALPACA_API_SECRET=your_alpaca_paper_api_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_AUTHORIZED_CHAT_ID=your_telegram_chat_id

# ── Safety ────────────────────────────────────────────────────────────────────
# Set to true ONLY after confirming live keys and accepting risk of real money
LIVE_TRADING_CONFIRMED=false
# Set to true to simulate orders without sending to Alpaca
DRY_RUN=false

# ── Bot behaviour ─────────────────────────────────────────────────────────────
EOD_CLOSE_MINUTES_BEFORE=5
WARMUP_MINUTES_BEFORE_OPEN=5
PENDING_STRATEGY_TTL_SECONDS=600
HEALTHCHECK_INTERVAL_MINUTES=15

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite default (relative path from project root)
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db
